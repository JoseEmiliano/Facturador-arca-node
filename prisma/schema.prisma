datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model Empresa {
  id             Int          @id @default(autoincrement())
  razonSocial    String       @map("razon_social") @db.VarChar(150)
  nombreComercial String      @default("MAXI KIOSCO 24/7") @map("nombre_comercial") @db.VarChar(150)
  cuit           String   @unique @db.VarChar(20)
  condicionIva   String       @map("condicion_iva") @db.VarChar(50)
  direccion      String       @default("") @db.VarChar(200)
  telefono       String       @default("") @db.VarChar(50)
  email          String       @default("") @db.VarChar(150)
  plan           String       @default("PyME") @db.VarChar(30)
  limiteMensual  Int          @default(1000) @map("limite_mensual")
  arcaHabilitado Boolean  @default(false) @map("arca_habilitado")
  arcaAmbiente   String   @default("homologacion") @map("arca_ambiente") @db.VarChar(20)
  arcaPuntoVenta Int      @default(1) @map("arca_punto_venta")
  creadoEn       DateTime @default(now()) @map("creado_en")

  usuarios       Usuario[]
  puntosVenta    PuntoVenta[]
  productos      Producto[]
  clientes       Cliente[]
  comprobantes   Comprobante[]

  @@map("empresas")
}

model PuntoVenta {
  id          Int       @id @default(autoincrement())
  empresaId   Int       @map("empresa_id")
  numero      Int
  nombre      String    @db.VarChar(100)
  creadoEn    DateTime  @default(now()) @map("creado_en")

  empresa     Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarios    Usuario[]

  @@unique([empresaId, numero])
  @@map("puntos_venta")
}

model Usuario {
  id            Int          @id @default(autoincrement())
  empresaId     Int          @map("empresa_id")
  email         String       @unique @db.VarChar(150)
  passwordHash  String       @map("password_hash") @db.VarChar(255)
  nombre        String       @db.VarChar(100)
  rol           String       @default("vendedor") @db.VarChar(30)
  puntoVentaId  Int?         @map("punto_venta_id")
  creadoEn      DateTime     @default(now()) @map("creado_en")

  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  puntoVenta    PuntoVenta?  @relation(fields: [puntoVentaId], references: [id])
  comprobantes  Comprobante[]

  @@map("usuarios")
}

model Producto {
  id           Int      @id @default(autoincrement())
  empresaId    Int      @map("empresa_id")
  codigo       String   @db.VarChar(50)
  nombre       String   @db.VarChar(150)
  precio       Decimal  @db.Decimal(12, 2)
  stock        Int      @default(0)
  stockMinimo  Int      @default(10) @map("stock_minimo")
  tipo         String   @default("unidad") @db.VarChar(30)
  creadoEn     DateTime @default(now()) @map("creado_en")

  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("productos")
}

model Cliente {
  id            Int      @id @default(autoincrement())
  empresaId     Int      @map("empresa_id")
  nombre        String   @db.VarChar(150)
  cuitDni       String   @map("cuit_dni") @db.VarChar(20)
  condicionIva  String   @map("condicion_iva") @db.VarChar(50)
  email         String?  @db.VarChar(150)
  telefono      String?  @db.VarChar(50)
  creadoEn      DateTime @default(now()) @map("creado_en")

  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("clientes")
}

model Comprobante {
  id                   Int      @id @default(autoincrement())
  empresaId            Int      @map("empresa_id")
  usuarioId            Int      @map("usuario_id")
  puntoVenta           Int      @map("punto_venta")
  tipoComprobante      Int      @map("tipo_comprobante")
  nroComprobante       Int      @map("nro_comprobante")
  numero               String   @db.VarChar(30)
  fecha                String   @db.VarChar(20)
  hora                 String?  @db.VarChar(15)
  cuitEmisor           String   @map("cuit_emisor") @db.VarChar(20)
  receptorNombre       String   @map("receptor_nombre") @db.VarChar(150)
  receptorDoc          String   @map("receptor_doc") @db.VarChar(20)
  receptorCondicionIva String   @map("receptor_condicion_iva") @db.VarChar(50)
  conceptoDesc         String   @map("concepto_desc")
  importe              Decimal  @db.Decimal(12, 2)
  esArca               Boolean  @default(false) @map("es_arca")
  cae                  String   @db.VarChar(50)
  caeVto               String   @map("cae_vto") @db.VarChar(20)
  qrBase64             String   @map("qr_base64")
  itemsJson            Json     @map("items_json")
  creadoEn             DateTime @default(now()) @map("creado_en")

  empresa              Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario              Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("comprobantes")
}
